# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# Proveedor: groq | openrouter | openai | deepseek
#   groq y openrouter tienen plan gratuito; openai y deepseek requieren saldo (de pago)
LLM_PROVIDER=groq

# API key del proveedor elegido
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
#   OpenAI:     https://platform.openai.com/api-keys
#   DeepSeek:   https://platform.deepseek.com/api_keys
LLM_API_KEY=

# Modelo (verifica la lista vigente en la consola del proveedor)
#   Groq:       openai/gpt-oss-120b  (llama-3.3-70b-versatile ya no está disponible)
#   OpenRouter: meta-llama/llama-3.3-70b-instruct:free
#   OpenAI:     gpt-4.1-mini
#   DeepSeek:   deepseek-chat
LLM_MODEL=openai/gpt-oss-120b

# Parámetros por defecto del modelo
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# --- Lab 02 (RAG) -----------------------------------------------------------
# Opcionales: si no se definen se usan estos valores.
# Después de cambiar EMBEDDING_MODEL o RAG_CHUNK_*, vuelve a ejecutar ingest.py.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_CHUNK_SIZE=80
RAG_CHUNK_OVERLAP=20
RAG_TOP_K=4
RAG_MIN_SCORE=0.35

# --- Examen final (Telegram + rostro) ----------------------------------------
# Token del bot: se crea con @BotFather (/newbot). Es un SECRETO, igual que la API key.
TELEGRAM_BOT_TOKEN=
# Similitud coseno mínima para aceptar un rostro (justificada con la tabla FAR/FRR del informe)
FACE_MATCH_THRESHOLD=0.363
# Minutos de validez de una sesión autenticada
SESSION_MINUTES=10
# Intentos fallidos de login antes del bloqueo temporal, y minutos de bloqueo
LOGIN_MAX_ATTEMPTS=3
LOCKOUT_MINUTES=5
# Segundos para enviar la video-nota del reto
LIVENESS_TIMEOUT_SECONDS=60
# Signo del giro: +1 si la cámara NO espeja, -1 si espeja (calibrar con liveness.py --calibrar)
LIVENESS_SIGNO_IZQUIERDA=1
LIVENESS_YAW_MINIMO=0.18
